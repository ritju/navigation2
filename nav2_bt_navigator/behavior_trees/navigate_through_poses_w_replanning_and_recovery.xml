<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="0" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <Sequence>
            <RemovePassedGoals
              input_goals="{goals}"
              output_goals="{goals}"
              output_gpp_goals="{gpp_goals}"
              radius="5.0"
              accumulate_distance="8.0"
              max_gpp_segment_m="1000.0"
              replan_trigger_arc_m="100.0"
              teb_message_timeout_s="2.0"
              pass_check_max_search_dist_m="8.0"
              pass_behind_tol_m="0.0"
              pass_enable_yaw_check="false"
              pass_yaw_threshold_rad="2.6"
              pass_tail_relax_remaining_path_max_m="2.0"
              pass_tail_relax_radius_m="1.0"
              global_frame="map"
              robot_base_frame="base_link"
              teb_topic="teb_global_plan"
              odom_topic="odom"
              pass_check_min_odom_linear_x_mps="0.1"
              gpp_goal_pose_match_xy_m="0.1"
              gpp_goal_pose_match_yaw_rad="-1.0"
              enable_backward_mode="false"
            />
          </Sequence>
        </RateController>
        <RecoveryNode number_of_retries="0" name="ComputePathToPose">
            <Fallback>
              <ReactiveSequence>
                <Inverter>
                  <PathExpiringTimer seconds="10000" path="{path}"/>
                </Inverter>
                <Inverter>
                  <GlobalUpdatedGoal goals="{gpp_goals}"/>
                </Inverter>
              </ReactiveSequence>
              <Sequence>
                <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_except_global_costmap" reset_distance="10.0"/>
                <ComputePathThroughPoses gpp_goals="{gpp_goals}" path="{path}" planner_id="GridBased"/>
              </Sequence>
            </Fallback>
            <Sequence>
              <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_except_global_costmap" reset_distance="10.0"/>
            </Sequence>
        </RecoveryNode>
        <RecoveryNode number_of_retries="0" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath" input_goals="{gpp_goals}"/>
          <Sequence>
            <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="local_costmap/clear_except_local_costmap" reset_distance="10.0"/>
            <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_except_global_costmap" reset_distance="10.0"/>
            <Wait wait_duration="2.0"/>
            <ComputePathThroughPoses gpp_goals="{gpp_goals}" path="{path}" planner_id="GridBased"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <Sequence name="RecoveryActions">
          <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="local_costmap/clear_except_local_costmap" reset_distance="5.0"/>
          <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_except_global_costmap" reset_distance="8.0"/>
          <Wait wait_duration="5.0"/>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>